{
  "hosting": {
    "buildCommand": "NITRO_PRESET=vercel pnpm run build",
    "buildOutputDir": ".vercel/output",
    "nodeVersion": "22",
    "environment": {
      "build": {
        "NITRO_PRESET": "vercel"
      },
      "prod": {
        "NODE_ENV": "production",
        "AUTH_DISABLED": "true"
      }
    }
  }
}
